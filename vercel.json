{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Static site - nothing to install'",
  "buildCommand": "echo 'Static site - nothing to build'",
  "outputDirectory": "frontend",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "https://YOUR-BACKEND-DOMAIN.com/api/:path" },
    { "source": "/media/:path(.*)", "destination": "https://YOUR-BACKEND-DOMAIN.com/media/:path" },
    { "source": "/admin/:path(.*)", "destination": "https://YOUR-BACKEND-DOMAIN.com/admin/:path" },
    { "source": "/admin", "destination": "https://YOUR-BACKEND-DOMAIN.com/admin/" },
    { "source": "/static/:path(.*)", "destination": "https://YOUR-BACKEND-DOMAIN.com/static/:path" },
    { "source": "/ckeditor/:path(.*)", "destination": "https://YOUR-BACKEND-DOMAIN.com/ckeditor/:path" }
  ]
}